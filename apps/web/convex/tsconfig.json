{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@the-pull/schema": ["../../../packages/schema/types.ts"],
      "@the-pull/shared/markdown": [
        "../../../packages/shared/markdown/index.ts"
      ]
    }
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
