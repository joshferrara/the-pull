{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-pull-prod",
  "account_id": "3ae801a7425f3c280128875b9cec4c4a",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "the-pull-prod"
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    { "binding": "BRIEFS_BUCKET", "bucket_name": "the-pull-briefs" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "the-pull-next-cache" }
  ],
  "kv_namespaces": [
    {
      "binding": "TOKENS_KV",
      "id": "e93cc437d4b24edd832d3801b8c4e82d"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "64190c2878e84a918f23146015c55d23"
    }
  ],
  /*
   * Cloudflare Email Service binding. Requires Email Routing to be enabled on
   * the thepull.dev zone first (Dashboard → Email → Email Routing).
   */
  // "send_email": [
  //   { "name": "EMAIL", "destination_address": "deliveries@thepull.dev" }
  // ],
  /*
   * Custom routes. Add thepull.dev as a zone in this Cloudflare account first,
   * then uncomment.
   */
  // "routes": [
  //   { "pattern": "thepull.dev", "custom_domain": true },
  //   { "pattern": "www.thepull.dev", "custom_domain": true }
  // ],
  /*
   * Spec section 5.13: Cloudflare Cron Triggers. The custom worker's
   * scheduled() handler maps each cron expression to a Convex action.
   * Convex also has its own internal cron schedule as a redundancy
   * (see apps/web/convex/crons.ts) so a Worker outage doesn't drop the
   * daily publish.
   */
  "triggers": {
    "crons": [
      "0 2 * * 1-5",
      "0 11 * * 1-5",
      "0 12 * * 1-5",
      "0 0 * * *"
    ]
  },
  "vars": {
    "CMS_EMAIL": "joshferrara@gmail.com",
    /*
     * Email providers:
     *   "cloudflare" — requires Email Routing enabled on the zone + send_email binding (default once domain is set up)
     *   "resend"     — requires RESEND_API_KEY secret
     *   "stub"       — captures sends into KV for the /api/internal/stub-emails debug endpoint (used pre-launch)
     */
    "EMAIL_PROVIDER": "resend",
    /*
     * EMAIL_FROM defaults to Resend's `onboarding@resend.dev` so sends work
     * without a verified domain. Once thepull.dev is verified in Resend, set
     * this to "The Pull <hello@thepull.dev>".
     */
    "EMAIL_FROM": "The Pull <onboarding@resend.dev>",
    /*
     * SITE_URL: points to the active public URL. Change to https://thepull.dev
     * once the custom domain is wired (uncomment the routes block above).
     */
    "SITE_URL": "https://the-pull-prod.joshferrara.workers.dev"
  }
}
